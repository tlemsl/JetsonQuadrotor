<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>optitrack_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 Foxy helpers: NatNet rigid body pose publisher and VRPN launch wiring.</description>
  <maintainer email="none@example.com">DroneXavier</maintainer>
  <license>Apache-2.0</license>

  <depend>px4_msgs</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- Install from source (ROS 2 / ament): https://github.com/NOKOV-MOCAP/vrpn_client_ros/tree/foxy-devel -->
  <exec_depend>vrpn_client_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
